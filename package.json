{
  "name": "template-nestjs-api",
  "version": "0.1.0",
  "description": "NestJS backend template with CQRS, GraphQL (Yoga Federation v2), REST (Swagger), MCP, OAuth, Prisma, CASL",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prisma:generate": "npx prisma generate && npm run prisma:postgenerate",
    "prisma:postgenerate": "echo \"export * from './client';\" > src/__generated__/client/index.ts",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "seed": "ts-node prisma/seed/seed.ts",
    "seed:prod": "node dist/prisma/seed/seed.js",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "revisium:standalone": "npx revisium standalone --port 8888 --pg-port 5441 --data ./revisium/data --auth",
    "revisium:save-migrations": "npx revisium migrate save --file ./revisium/migrations.json",
    "revisium:apply-migrations": "npx revisium migrate apply --file ./revisium/migrations.json",
    "generate:dictionary-api": "echo 'TODO: configure swagger-typescript-api generation from Revisium endpoint'",
    "start:prod": "NODE_ENV=production npm run revisium:apply-migrations && npm run prisma:migrate:deploy && npm run seed:prod && node dist/src/main",
    "lint:ci": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --max-warnings 0 --fix",
    "tsc": "tsc -p tsconfig.json",
    "test": "NODE_ENV=test jest --maxWorkers=50% --forceExit",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --maxWorkers=50% --forceExit --coverage --silent",
    "docker:test-container-up": "docker compose -f docker/docker-compose-test.yml -p template-test up -d && sleep 1 && dotenv -e .env.test npm run prisma:migrate:deploy && dotenv -e .env.test npm run seed",
    "docker:test-container-down": "docker compose -f docker/docker-compose-test.yml -p template-test down --volumes",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@casl/ability": "^6.7.5",
    "@graphql-yoga/nestjs": "^3.8.0",
    "@graphql-yoga/nestjs-federation": "^3.8.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "bcrypt": "^6.0.0",
    "bentocache": "^1.6.1",
    "cookie-parser": "^1.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.18.0",
    "ioredis": "^5.9.0",
    "nanoid": "^3.3.11",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "revisium": "^2.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^3.0.2",
    "globals": "^16.1.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "jest": {
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2021",
            "parser": {
              "syntax": "typescript",
              "tsx": false,
              "decorators": true
            },
            "transform": {
              "decoratorMetadata": true
            }
          },
          "module": {
            "type": "commonjs"
          },
          "sourceMaps": "inline"
        }
      ]
    },
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.(t|j)s",
      "!<rootDir>/src/main.ts",
      "!<rootDir>/src/__generated__/**",
      "!<rootDir>/src/**/__tests__/**",
      "!<rootDir>/src/**/index.ts",
      "!<rootDir>/src/**/*.module.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "testTimeout": 30000,
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^bentocache$": "<rootDir>/src/infrastructure/cache/__mocks__/bentocache.js",
      "^bentocache/drivers/memory$": "<rootDir>/src/infrastructure/cache/__mocks__/bentocache-memory.js",
      "^bentocache/drivers/redis$": "<rootDir>/src/infrastructure/cache/__mocks__/bentocache-redis.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
