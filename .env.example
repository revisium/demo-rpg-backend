# Server
PORT=8080
PUBLIC_URL=http://localhost:8080

# Database (required)
DATABASE_URL=postgresql://template:password@localhost:5433/template-dev

# Authentication (required)
JWT_SECRET=
ADMIN_PASSWORD=

# No-auth mode (set to true for local development without JWT)
# NO_AUTH=true

# JWT refresh tokens
# JWT_REFRESH_TOKEN_TTL_DAYS=7
# JWT_REFRESH_GRACE_PERIOD_MS=30000
# COOKIE_SECURE=

# Cache
# CACHE_ENABLED=true
# CACHE_L1_MAX_SIZE=128mb
# CACHE_L2_REDIS_URL=redis://localhost:6380
# CACHE_BUS_HOST=localhost
# CACHE_BUS_PORT=6380

# OAuth (for MCP clients)
# MCP_ACCESS_TOKEN_EXPIRY_DAYS=30

# Metrics
# METRICS_ENABLED=true

# Revisium (dictionary service)
# REVISIUM_URL=revisium://admin@localhost:8888/admin/dictionary/master/draft
# REVISIUM_API_URL=http://localhost:8888
# REVISIUM_USERNAME=admin
# REVISIUM_PASSWORD=admin

# Graceful shutdown
# GRACEFUL_SHUTDOWN_TIMEOUT=10000
